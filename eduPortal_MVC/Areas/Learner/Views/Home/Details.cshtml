@model Cart


<form method="post">
    <input type="hidden" asp-for="@Model.VCourseId"/>
    <div class="container mt-4">

        <!-- Course Header Section -->
        <div class="row">
            <div class="col-lg-8">

                <p class="badge bg-success">@Model.VCourse.Category.Name</p>

                <h1 class="fw-bold"> @Model.VCourse.Title</h1>

                <p class="text-muted fs-5">
                    @Html.Raw(Model.VCourse.Description)
                </p>

                <div class="d-flex gap-4 mt-3">
                    <div>
                        <i class="bi bi-star-fill" style="color:yellow"></i> ratings
                    </div>
                    <div>
                        <i class="bi bi-people-fill"></i> students
                    </div>
                    <div>
                        <i class="bi bi-hourglass"></i> hours content
                    </div>
                </div>

                <div class="mb-3">
                    <video id="mainVideo" width="100%" controls poster="@Model.VCourse.ThumbnailUrl" class="mb-3">
                        <source id="mainVideoSource" src="" type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>
                
                  
                     <div>
                         <h3>What will Student Learn?</h3>
                        <p>@Html.Raw(Model.VCourse.AddInfo)</p>
                     </div>
            </div>

            <!-- Right Side Pricing Box -->
            <div class="col-lg-4">
                <div class="card shadow-sm p-3 sticky-top" style="top: 100px;">

                    <img src="@Model.VCourse.ThumbnailUrl"
                         class="img-fluid rounded mt-4 shadow" />

                    

                    <h3 class="fw-bold mt-2">$@Model.VCourse.Price</h3>

                    <button type="submit"
                       class="btn btn-dark w-100 mt-3">
                        Add To Cart
                    </button>

                    <a asp-controller="" asp-action="" asp-route-id=""
                       class="btn btn-outline-dark w-100 mt-2">
                        Buy Now
                    </a>

                    <ul class="mt-3 list-unstyled">
                        <li>Life-time full access</li>
                        <li>Quizz and Learning</li>
                        <li>30 days gurantee learning</li>
                    </ul>
                </div>

                <!-- Instructor Info -->
                <div class="card mt-3 p-3 shadow-sm">
                    <p class="text-muted">Instructor</p>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <div>

                            <h6 class="mb-0 fw-bold">@(Model.VCourse.ApplicationUser?.Name ?? "Unknown instructor")</h6>

                        </div>
                    </div>
                    
                    <div class="mt-3">

                        <div class="d-flex justify-content-between">
                            <p class="mb-1">Students:</p>
                            <p class="mb-1">InstructorStudents</p>
                        </div>

                        <div class="d-flex justify-content-between">
                            <p class="mb-1">Courses:</p>
                            <p class="mb-1">@((int?)ViewBag.InstructorCourseCount ?? 0) total courses</p>
                        </div>

                        <div class="d-flex justify-content-between">
                            <p class="mb-1">Rating:</p>
                            <p class="mb-1"><i class="bi bi-star-fill" style="color:yellow"></i> InstructorRating</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">

        <ul class="nav nav-tabs mt-4" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#curriculum">Curriculum</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#resources">Resources</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#quizzes">Quizzes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#reviews">Reviews</a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Curriculum Tab -->
            <div class="tab-pane fade show active mt-4" id="curriculum">
                <h5>Course Curriculum</h5>
                <p>
                    @Model.VCourse.Sections.Count() Section •
                    @(Model.VCourse.Sections?.Sum(s => s.Lectures != null ? s.Lectures.Count : 0) ?? 0) Lectures •
                    @Model.VCourse.Duration
                </p>


                @foreach (var sec in Model.VCourse.Sections)
                {
                <div class="card mb-2">
                    <div class="card-header bg-white fw-semibold">
                        @sec.SectionTitle
                        <span class="float-end">@sec.Lectures.Count lessons </span>
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var lec in sec.Lectures)
                        {
                        <li class="list-group-item d-flex justify-content-between ">
                            <div class="lecture-item mb-2" onclick="playLecture('@GetVideoUrl(lec.VideoUrl)')" style="cursor: pointer;">
                                <span>@lec.LectureTitle</span>
                            </div>
                        </li>
                        }
                    </ul>
                </div>
                }

            </div>

            <div class="tab-pane fade mt-4" id="resources">
                <p>No resources yet.</p>
            </div>

            <div class="tab-pane fade mt-4" id="quizzes">
                <p>No quizzes yet.</p>
            </div>

            <div class="tab-pane fade mt-4" id="reviews">
                <p>No reviews yet.</p>
            </div>
        </div>

    </div>
</form>

@functions {
    private string GetVideoUrl(string videoUrl)
    {
        if (string.IsNullOrEmpty(videoUrl))
            return "";

        // Remove leading backslashes
        var cleanUrl = videoUrl.TrimStart('\\', '/');

        // If it's a full URL, return as is
        if (cleanUrl.StartsWith("http://") || cleanUrl.StartsWith("https://"))
            return cleanUrl;

        // Make it a web-accessible path
        // If stored as "videos/lecture1.mp4", make it "/videos/lecture1.mp4"
        if (!cleanUrl.StartsWith("/"))
            cleanUrl = "/" + cleanUrl;

        // Use Url.Content to ensure proper path
        return Url.Content("~" + cleanUrl);
    }
}
@section Scripts {

    <script>
        function playLecture(videoUrl)
        {
            var video = document.getElementById("mainVideo");
            var source = document.getElementById("mainVideoSource");

            if (!video || !source) {
                alert("Video player not found");
                return;
            }

            if (!videoUrl) {
                alert("Video URL is missing");
                return;
            }

            // Set source
            source.src = videoUrl;

            // Load video
            video.load();

            // Wait for video to be ready, then enable controls
            video.addEventListener('loadeddata', function() {
                // Video data is loaded, controls should work now
                console.log("Video loaded, controls enabled");
            }, { once: true });

            // Try to play (may be blocked by browser)
            video.play().catch(function() {
                // Normal - user can click play button
            });
        }
    </script>
}