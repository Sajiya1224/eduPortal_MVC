@model Cart


<form method="post">
    <input type="hidden" asp-for="@Model.VCourseId"/>
    <div class="container mt-4">

        <!-- Course Header Section -->
        <div class="row">
            <div class="col-lg-8 text-black">

                <p class="badge bg-success">@Model.VCourse.Category.Name</p>

                <h1 class="fw-bold custom-color-medium"> @Model.VCourse.Title</h1>

                <p class="text-black fs-5">
                    @Html.Raw(Model.VCourse.Description)
                </p>

                <div class="d-flex gap-4 mt-3">
                    <div>
                        <i class="bi bi-star-fill" style="color:yellow"></i> ratings
                    </div>
                    <div>
                        <i class="bi bi-people-fill"></i> students
                    </div>
                    <div>
                        <i class="bi bi-hourglass"></i> hours content
                    </div>
                </div>

                <div class="mb-3 sticky-top">
                    <video id="mainVideo" width="100%" controls poster="@Model.VCourse.ThumbnailUrl" class="mb-3">
                        <source id="mainVideoSource" src="" type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>
                
                  
                     <div>
                         <h3>What will Student Learn?</h3>
                        <p>@Html.Raw(Model.VCourse.AddInfo)</p>
                     </div>
            </div>

            <!-- Right Side Pricing Box -->
            <div class="col-lg-4 text-black">
                @if ((bool?)ViewBag.IsEnrolled == true)
                {

                    <div class="card shadow-sm p-3 sticky-top" style="top: 100px;">

                        <img src="@Model.VCourse.ThumbnailUrl"
                             class="img-fluid rounded mt-4 shadow" />

                        <div class="alert alert-success mt-3" role="alert">
                            <i class="bi bi-check-circle-fill"></i> You are enrolled in this course
                        </div>

                        <ul class="mt-3 list-unstyled">
                            <li><i class="bi bi-check-circle text-success"></i> Life-time full access</li>
                            <li><i class="bi bi-check-circle text-success"></i> Quizz and Learning</li>
                            <li><i class="bi bi-check-circle text-success"></i> 30 days guarantee learning</li>
                        </ul>
                    </div>


                }

             
                else
                {
                    <div class="card shadow-sm p-3 sticky-top" style="top: 100px;">

                        <img src="@Model.VCourse.ThumbnailUrl"
                             class="img-fluid rounded mt-4 shadow" />

                        <h3 class="fw-bold mt-2">$@Model.VCourse.Price</h3>

                        <button type="submit"
                                class="btn btn-custom w-100 mt-3">
                            Add To Cart
                        </button>

                        <ul class="mt-3 list-unstyled">
                            <li>Life-time full access</li>
                            <li>Quizz and Learning</li>
                            <li>30 days guarantee learning</li>
                        </ul>
                    </div>
                }
                    <!-- Instructor Info -->
                    <div class="card mt-3 p-3 shadow-sm">
                        <p class="text-muted">Instructor</p>
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <div>
                                <h6 class="mb-0 fw-bold">@(Model.VCourse.ApplicationUser?.Name ?? "Unknown instructor")</h6>
                            </div>
                        </div>
                        
                        <div class="mt-3">
                            <div class="d-flex justify-content-between">
                                <p class="mb-1">Students:</p>
                                <p class="mb-1">InstructorStudents</p>
                            </div>

                            <div class="d-flex justify-content-between">
                                <p class="mb-1">Courses:</p>
                                <p class="mb-1">@((int?)ViewBag.InstructorCourseCount ?? 0) total courses</p>
                            </div>

                            <div class="d-flex justify-content-between">
                                <p class="mb-1">Rating:</p>
                                <p class="mb-1"><i class="bi bi-star-fill" style="color:yellow"></i> InstructorRating</p>
                            </div>
                        </div>
                    </div>
                </div>
            
        </div>
    </div>

    <div class="container mt-4 text-dark">

        <ul class="nav nav-tabs mt-4" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#curriculum">Curriculum</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#resources">Resources</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#quizzes">Quizzes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#reviews">Reviews</a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Curriculum Tab -->
            <div class="tab-pane fade show active mt-4" id="curriculum">
                <h5>Course Curriculum</h5>
                <p>
                    @Model.VCourse.Sections.Count() Section •
                    @(Model.VCourse.Sections?.Sum(s => s.Lectures != null ? s.Lectures.Count : 0) ?? 0) Lectures •
                    @Model.VCourse.Duration
                </p>

                @foreach (var sec in Model.VCourse.Sections)
                {
                    <div class="accordion mb-2" id="accordionSection_@sec.Id">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading_@sec.Id">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#collapse_@sec.Id" aria-expanded="false"
                                        aria-controls="collapse_@sec.Id">
                                    <div class="d-flex justify-content-between w-100 me-3">
                                        <span class="fw-semibold">@sec.SectionTitle</span>
                                        <span class="text-muted">@sec.Lectures.Count lessons</span>
                                    </div>
                                </button>
                            </h2>


                            @if ((bool?)ViewBag.IsEnrolled == true)
                            {
                                <div id="collapse_@sec.Id" class="accordion-collapse collapse"
                                     aria-labelledby="heading_@sec.Id" data-bs-parent="#accordionSection_@sec.Id">
                                    <div class="accordion-body p-0">
                                        <ul class="list-group list-group-flush">
                                            @foreach (var lec in sec.Lectures)
                                            {
                                                <li class="list-group-item d-flex justify-content-between">
                                                    <div class="lecture-item mb-2"
                                                         data-lecture-id="@lec.Id"
                                                         style="cursor: pointer;">
                                                        <span>@lec.LectureTitle</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="collapse_@sec.Id" class="accordion-collapse collapse"
                                     aria-labelledby="heading_@sec.Id" data-bs-parent="#accordionSection_@sec.Id">
                                    <div class="accordion-body p-0">
                                        <ul class="list-group list-group-flush">
                                            @foreach (var lec in sec.Lectures)
                                            {
                                                <li class="list-group-item d-flex justify-content-between">
                                                    <div class="lecture-item mb-2 text-muted"
                                                         style="cursor: not-allowed; opacity: 0.6;">
                                                        <span>
                                                            <i class="bi bi-lock-fill"></i> @lec.LectureTitle
                                                        </span>
                                                        <small class="text-muted">(Enroll to access)</small>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
