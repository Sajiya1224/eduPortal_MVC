                            @* { *@
                            @*     <div id="collapse_@sec.Id" class="accordion-collapse collapse" *@
                            @*          aria-labelledby="heading_@sec.Id" data-bs-parent="#accordionSection_@sec.Id"> *@
                            @*         <div class="accordion-body p-0"> *@
                            @*             <ul class="list-group list-group-flush"> *@
                            @*                 @foreach (var lec in sec.Lectures) *@
