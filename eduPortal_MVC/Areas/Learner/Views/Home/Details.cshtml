                            @*         </div> *@
                            @*     </div> *@
                            @* } *@
                           
                        </div>
                    </div>
                }



            </div>

            <div class="tab-pane fade mt-4" id="resources">
                <p>No resources yet.</p>
            </div>

            <div class="tab-pane fade mt-4" id="quizzes">
                <p>No quizzes yet.</p>
            </div>

            <div class="tab-pane fade mt-4" id="reviews">
                <p>No reviews yet.</p>
            </div>
        </div>

    </div>
</form>


@section Scripts {
    <script>
        function playLecture(lectureId)
        {
            var video = document.getElementById("mainVideo");
            var source = document.getElementById("mainVideoSource");

            if (!video || !source) {
                alert("Video player not found");
                return;
            }

            if (!lectureId) {
                alert("Lecture ID is missing");
                return;
            }

            // Build the video URL using the PlayVideo action
            var videoUrl = '@Url.Action("PlayVideo", "Home", new { area = "Learner" })?lectureId=' + lectureId;

            // Set source
            source.src = videoUrl;

            // Load video
            video.load();

            // Wait for video to be ready, then enable controls
            video.addEventListener('loadeddata', function() {
                // Video data is loaded, controls should work now
                console.log("Video loaded, controls enabled");
            }, { once: true });

            // Handle video errors
            video.addEventListener('error', function(e) {
                console.error("Video error:", e);
                alert("Unable to load video. Please make sure you are enrolled in this course and logged in.");
            });

            // Try to play (may be blocked by browser)
            video.play().catch(function(error) {
                // Normal - user can click play button
                console.log("Autoplay prevented:", error);
            });
        }

        // Add event listeners to lecture items
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.lecture-item').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent accordion collapse
                    var lectureId = this.getAttribute('data-lecture-id');
                    if (lectureId) {
                        playLecture(lectureId);
                    }
                });
            });
        });
    </script>




