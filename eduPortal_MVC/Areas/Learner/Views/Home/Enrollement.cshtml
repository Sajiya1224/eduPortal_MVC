@model IEnumerable<OrderDetails>
@{
    int enrolledCount = ViewBag.EnrolledCoursesCount is int c ? c : 0;
}

<div class="container">
    <h4 class="fw-semibold mt-4">My Learning</h4>
    <p class="text-muted mb-0">Welcome, <strong>@(ViewBag.LearnerName ?? "Learner") </strong></p><br/>
    <p class="fw-bold mb-0">Total course Enrolled : @(ViewBag.EnrolledCoursesCount ?? 0) </p>
    <div class="row">
        <div class="col-9">
            @if (enrolledCount == null || enrolledCount == 0)
            {
                <div class="col-12">
                    <div class="text-center ms-5">
                        <p class="text-muted">

                            <i class="bi bi-journal-plus" style="font-size:180px"></i><br />
                            <b class="text-dark">No Enrollement Yet !!</b><br />
                            The right course is waiting—explore until you find it.
                        </p>
                        <a asp-controller="Home" asp-action="BrowseCourse" class="btn btn-dark btn-lg px-4 py-2 shadow-sm">Keep Searching </a>
                    </div>
                </div>
            }

            else
            {

                @if (enrolledCount >= 1 && enrolledCount <= 4)
                {
                    @foreach (var obj in Model)
                    {
                        <div class="card p-3 shadow-sm my-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-2">
                                    <img src="@obj.VCourse.ThumbnailUrl" class="img-fluid rounded" />
                                </div>

                                <div class="col-md-6">
                                    <h5>@obj.VCourse.Title</h5>
                                    <span class="badge bg-success">@(obj.VCourse.IsPublished == true ? "Published" : "Not Published")</span>
                                    <div class="mt-2">
                                    </div>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a class="btn btn-outline-dark">View</a>
                                    <a class="btn btn-dark">Edit</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (enrolledCount > 4)
                {
                    <div class="row g-4">
                    @foreach (var obj in Model)
                    {
                        
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <a asp-controller="Home"
                            asp-action="Details"
                            asp-route-VideoCourseId="@obj.Id"
                            class="card shadow-sm border-0 h-100 text-decoration-none text-muted">

                                <!-- Course Image -->
                                <img src="@(obj.VCourse.ThumbnailUrl)" class="card-img-top"
                                style="height: 180px; object-fit: cover;" />

                                <div class="card-body">

                                    <!-- Category Name -->
                                    <h5 class="badge bg-success">
                                        @(obj.VCourse.Category.Name)
                                    </h5>


                                    <!-- Title -->
                                    <h5 class="card-title  fw-bold">
                                        @(obj.VCourse.Title)
                                    </h5>

                                    <!-- Instructor Name -->
                                    <p class="text-muted mb-1">
                                        Created by @(obj.VCourse.ApplicationUser?.Name ?? "Unknown instructor")
                                    </p>

                                    <!-- Rating -->
                                    <div class="d-flex align-items-center mb-2">
                                        @* <span class="text-warning me-1">★</span> *@
                                        @* <span class="fw-bold">@course.Rating</span> *@
                                        @* <span class="text-muted ms-1">(@course.RatingCount)</span> *@
                                    </div>

                                    <!-- Price -->
                                    <h5 class=" fw-bold text-end">$@(obj.VCourse.Price)</h5>

                                </div>
                            </a>
                        </div>
                        
                    }
                    </div>
                }
                
            }

        </div>
        <div class="col-lg-3">
            <div class="card mt-3 p-3 shadow-sm">
                <div class="d-flex align-items-center gap-3 mt-2">
                    <div>

                        <h6 class="mb-0 fw-bold">Quick Actions</h6>

                    </div>
                </div>

                <div class="mt-3">

                    <div class="p-2">
                        <a asp-area="Learner" asp-controller="Home" asp-action="Index"
                           class="btn btn-outline-dark p-2" style="width:100%"><i class="bi bi-house-fill" style="font-size:20px;"></i>  Home Page</a>
                    </div>

                    <div class="p-2">
                        <a asp-area="Learner" asp-controller="Home" asp-action="BrowseCourse"
                           class="btn btn-outline-dark  p-2" style="width:100%"><i class="bi bi-book" style="font-size:20px;"></i>  Browse Courses</a>
                    </div>

                    <div class="p-2">
                        <a asp-area="Learner" asp-controller="Cart" asp-action="Index"
                           class="btn btn-outline-dark p-2" style="width:100%"><i class="bi bi-cart-fill" style="font-size:20px;"></i>  Visit Cart</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
    
 
</div>


