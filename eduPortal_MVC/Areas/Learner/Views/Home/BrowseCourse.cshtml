
@model BrowseCourseVM

@{
    var currentCategoryId = Context.Request.Query["categoryId"].ToString();
}


<div class="container my-4">

    <h2 class="mb-3">Browse Categories</h2>
    <h5 class="mb-3" style="color: rgba(200,200,200,1)">Discover your next learning adventure from our collection</h5>

    <div class="category-scroll d-flex gap-3 mb-4">
        <a asp-action="BrowseCourse"
           asp-controller="Home"
           class="cat-btn text-dark text-decoration-none @(string.IsNullOrEmpty(currentCategoryId) ? "active" : "")">
            All Courses
        </a>
        @foreach (var obj in Model.CategoryList)
        {
            <a asp-action="BrowseCourse"
               asp-controller="Home"
               asp-route-categoryId="@obj.Id"
               class="cat-btn text-dark text-decoration-none @(currentCategoryId == obj.Id.ToString() ? "active" : "")">
                @obj.Name
            </a>
        }
    </div>

 

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-muted">Showing @Model.videoCourse.Count() courses</h5>
        </div>
    </div>

    <div class="row g-4">
            @foreach (var course in Model.videoCourse)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <a asp-controller="Home" 
                    asp-action="Details" 
                    asp-route-VideoCourseId ="@course.Id" 
                    class="card shadow-sm border-0 h-100 text-decoration-none text-muted">

                    <!-- Course Image -->
                    <img src="@course.ThumbnailUrl" class="card-img-top" 
                         style="height: 180px; object-fit: cover;" />

                    <div class="card-body">

                        <!-- Category Name -->
                        <h5 class="badge bg-success">
                            @course.Category.Name
                        </h5>


                        <!-- Title -->
                            <h5 class="card-title  fw-bold">
                            @course.Title
                        </h5>

                        <!-- Instructor Name -->
                        <p class="text-muted mb-1">
                                Created by @(course.ApplicationUser?.Name ?? "Unknown instructor")
                        </p>

                        <!-- Rating -->
                        <div class="d-flex align-items-center mb-2">
                            @* <span class="text-warning me-1">★</span> *@
                            @* <span class="fw-bold">@course.Rating</span> *@
                            @* <span class="text-muted ms-1">(@course.RatingCount)</span> *@
                        </div>

                        <!-- Price -->
                            <h5 class=" fw-bold text-end">$@course.Price</h5>

                    </div>
                </a>
            </div>
        }
    </div>
</div>


</div>


