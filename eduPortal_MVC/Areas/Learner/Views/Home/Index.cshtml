@model BrowseCourseVM
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="mt-0 hero-section d-flex align-items-center justify-content-between flex-column flex-md-row w-100 py-5"
style="background: linear-gradient(to bottom, rgba(200,200,200,0.7), #ffffff);">

    <!-- Left Content -->
    <div class="container-fluid px-5 px-md-5">
        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start">
                <h1 class="fw-bold display-5 text-dark mb-3">
                    Learn Without Limits
                </h1>
                <p class="text-muted mb-4 fs-5">
                    Access thousands of courses from world-class instructors. <br />
                    Build skills with courses, certificates, and degrees online from expert instructors.
                </p>
                <div class="d-flex justify-content-center justify-content-md-start gap-3">
                    <a asp-area="Learner" asp-controller="Home" asp-action="BrowseCourse" class="btn btn-secondary btn-lg px-4 py-2 shadow-sm">Browse Courses</a>
                    <a asp-area="Identity" asp-page="/Account/Register" asp-route-Role="Instructor" class="btn btn-outline-secondary btn-lg px-4 py-2">Become an Instructor</a>

                </div>
            </div>

            <!-- Right Image -->
            <div class="col-md-6 mt-5 mt-md-0 text-center">
                <img src="./hero_img.png" alt="Learning" class="img-fluid" style="max-width: 650px;">
            </div>
        </div>
    </div>

</div>

<!-- Search bar  -->
<div class="p-5 mt-3 mb-3">
    <form class="d-flex mx-auto custom-search">
        <input class="form-control rounded-pill search-input border-2"
        type="search"
        placeholder="Search courses..."
        aria-label="Search">
    </form>
</div>

@* <div class="input-group mt-5 p-3 " style="max-width: 800px; margin: auto;"> *@
@*     <input type="text" class="form-control rounded p-3 bg-light text-dark" placeholder="Search courses..." aria-label="Search courses"> *@
@*     <button class="btn btn-secondary" type="button">Search</button> *@
@* </div> *@



<!-- Browse by Category -->

<div class="p-2 bg-light">
    <div class="container my-5">
        <h2 class="mb-3 text-center">Browse by Category</h2>
        <h5 class="mb-5 text-center text-muted">Explore our most popular course categories</h5>

        <div class="row g-4">
            @foreach (var obj in Model.CategoryList.Take(4))
            {
                <div class="col-md-3 text-decoration-none">
                    <div class="card shadow-sm h-100 rounded-full">
                        <div class="card-body p-4 text-center">
                        <a asp-controller="Home" asp-action="BrowseCourse" class="card-title text-muted">@obj.Name</a>
                        </div>
                    </div>
                </div>
            }

        </div>
        <div class="mt-5 text-center text-muted">
            <a asp-area="Learner" asp-controller="Home" asp-action="BrowseCourse" class="btn btn-outline-secondary btn-lg px-4 py-2">More</a>
       </div>
           
    </div>
</div>


<!-- Browse by Course -->

<div class="p-2">
    <div class="container my-5">
        <h2 class="mb-3 text-center">Featured Courses</h2>
        <h5 class="mb-5 text-center text-muted">Hand-picked courses to help you get started</h5>

        <div class="text-center mt-4">
            <div class="row g-4">
                @foreach (var course in Model.videoCourse.Take(4))
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <a asp-controller="Home" asp-action="Details" asp-route-VideoCourseId="@course.Id" 
                        class="card shadow-sm border-0 h-100 text-decoration-none">

                            <!-- Course Image -->
                            <img src="@course.ThumbnailUrl" class="card-img-top"
                                 style="height: 180px; object-fit: cover;" />

                            <div class="card-body">

                                <!-- Title -->
                                <h5 class="card-title fw-semibold">
                                    @course.Title
                                </h5>

                                <!-- Instructor Name -->
                                <p class="text-muted mb-1">
                                    @* @course.InstructorName *@
                                </p>

                                <!-- Rating -->
                                <div class="d-flex align-items-center mb-2">
                                    @* <span class="text-warning me-1">★</span> *@
                                    @* <span class="fw-bold">@course.Rating</span> *@
                                    @* <span class="text-muted ms-1">(@course.RatingCount)</span> *@
                                </div>

                                <!-- Price -->
                                <h5 class="fw-bold">$@course.Price</h5>

                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Become an Instructor -->

    <div class="mb-0 py-5" style="background-color: #0b0b1d; color: white;">
        <div class="container text-center">

           
            <div class="mb-4">
                <i class="bi bi-people" style="font-size: 90px;"></i>
            </div>

            <h2 class="fw-bold mb-3">Become an Instructor</h2>

            <p class="mb-4" style="max-width: 650px; margin: auto;">
                Share your knowledge with millions of students worldwide.
                Join our community of expert instructors and start earning today.
            </p>

            <a asp-area="Identity" asp-page="/Account/Register" asp-route-Role="Instructor" class="btn btn-light btn-lg px-4 py-2">
                Start Teaching Today
            </a>

        </div>
    </div>





