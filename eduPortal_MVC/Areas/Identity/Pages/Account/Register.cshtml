@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}


<div class="container d-flex justify-content-center py-2 mt-5 mb-5">

    <div class="card p-4 shadow-lg" style="width: 600px;">


        <!-- Your form here -->
        <div class="row">
            <div>
  
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">              
                        
                    <h3>Create a new account</h3>
                    <p class="text-muted">Join thousands of learners and instructors worldwide</p>

                    <div class="text-center mb-4">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" form="external-account"
                                    class="btn btn-outline-dark me-2"
                                    name="provider" value="@provider.Name">
                                <i class="bi bi-@provider.Name.ToLower()"></i> @provider.DisplayName
                            </button>
                        }
                    </div>

                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="row">
                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.Name" class="form-control custom-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Name" class="ms-2">Name</label>
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>
                    </div> 
                    
                    <div class="row">
                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.Email" class="form-control custom-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="ms-2">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.Password" class="form-control custom-input" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="ms-2">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">   
                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.ConfirmPassword" class="form-control custom-input" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword" class="ms-2">Confirm Password</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="Input.DateOfBirth" type="date" class="form-control custom-input" placeholder="name@example.com" />
                                <label asp-for="Input.DateOfBirth" class="ms-2">Date of Birth</label>
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6"> 
                            <div class="form-floating mb-3">
                                <select asp-for="Input.Gender" asp-items="Model.Input.GenderList" class="form-control custom-input" placeholder="name@example.com">
                                </select>
                                <label asp-for="Input.Gender" class="ms-2">Gender</label>
                                <span asp-validation-for="Input.Gender" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-12"> 
                            <div class="form-floating mb-3">
                                I want to join as :
                                <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select custom-input" placeholder="name@example.com">
                                   <option disabled selected>--Select a Role-- </option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating py-2 mb-3" id="CV" style="display:none">
                                <input type="file" name="Input.CV" class="form-control custom-input" placeholder="name@example.com" />
                                <label asp-for="Input.CV" class="ms-2">CV</label>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-floating py-2 mb-3" id="DemoVid" style="display:none">
                                <input type="file" name="Input.DemoVid" class="form-control custom-input" placeholder="name@example.com" />
                                <label asp-for="Input.DemoVid" class="ms-2">Teaching Demo Video</label>
                            </div>
                        </div>
                    </div>
                    <button id="registerSubmit" type="submit" class="btn btn-dark w-100 py-2 rounded-3">Register</button>

                    <hr/>
                    <div class="mb-3">
                        <p class="text-muted text-center py-2">Already have an account? 
                            <a id="login" class="text-black text-decoration-none" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                        </p>
                    </div>
                </form>


            </div>
           
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
         $(document).ready(function()
         {
            $('#Input_Role').change(function()
            {
                var selection = $('#Input_Role option:selected').text();
                if(selection === 'Instructor')
                {
                    $('#CV').show();
                    $('#DemoVid').show();
                }
                else
                {
                    $('#CV').hide();
                    $('#DemoVid').hide();
                }
        });


         var selectedRole = '@Model.Input.Role';

        if (selectedRole)
        {
            $('#Input_Role').val(selectedRole);

            if (selectedRole === 'Instructor')
            {
                $('#CV').show();
                $('#DemoVid').show();
            }
        }
    });

        // for selected Role


    </script>
}
