@model List<Category>



<div class="container">
    <div class="row pt-4">
        <div class="m-lg-0 py-3 text-center">
            <h2 class="text-dark">Category List</h2>
        </div> 

        <div class="col-12 p-3 text-end">
            <a asp-controller="Category" asp-action="Create" class="btn btn-dark">
                <i class="bi bi-plus-circle"></i>  Add Category
            </a>
        </div>
    </div>

    <table id="tblData" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Created At</th>
                <th> </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td>@obj.CreatedAt</td>
                    <td>
                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-secondary">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a asp-controller="Category" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger">
                            <i class="bi bi-trash3-fill"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>


@section Scripts{
    <script src="~/js/Category.js"></script>
}
