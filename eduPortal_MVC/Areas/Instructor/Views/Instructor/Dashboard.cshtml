@model InstructorDashboardVM

@{
    ViewData["Title"] = "Instructor Dashboard";

    
}
<div class="container custom-color-medium">
    <div class="row">
        <div class="col-lg-8 p-4">
            <h2 class="fw-bold custom-color-dark">Instructor Dashboard</h2>
            <p class="custom-color-medium mb-0">Welcome, <strong>@(ViewBag.InstructorName ?? "Instructor")</strong></p
            <p class="custom-color-medium">Track your teaching performance and manage courses</p>

            <div class="row g-4 my-4">
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm">
                        <h6>Enrolled Students</h6>
                         <h3>@Model.TotalEnrolledStudentsCount</h3>
                        @* <small class="text-success">+1,234 this month</small> *@
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm">
                        <h6>Total Revenue</h6>
                        <h3>$@Model.TotalEarnings</h3>
                        @* <small class="text-success">+15K this month</small> *@
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm">
                        <h6>Active Courses</h6>
                        <h3>@Model.TotalCoursesCount</h3>
                        @* <small class="text-muted">2 pending review</small> *@
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-semibold mb-0 mt-4">My Courses</h4>
                <a asp-area="Instructor" asp-controller="course" asp-action="index" class="btn btn-custom-outline"><i class="bi bi-kanban-fill"></i> Manage Courses</a>
            </div>
            
            @foreach (var courseStat in Model.CoursesWithStats.Take(4))
            {
                <div class="card p-3 shadow-sm my-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-2">
                            <img src="@courseStat.Course.ThumbnailUrl" class="img-fluid rounded" />
                        </div>

                        <div class="col-md-6">
                            <h5>@courseStat.Course.Title</h5>
                            <span class="badge bg-success">@(courseStat.Course.IsPublished == true ? "Published" : "Not Published")</span>
                            <div class="mt-2">
                                <small>Students: @courseStat.EnrollmentCount</small><br />
                                <small>Price: $@courseStat.Course.Price</small><br />
                                @* <small>Rating: ⭐ 4.8</small><br /> *@
                                @* <small>Revenue: $@Model.TotalEarnings</small> *@
                            </div>
                        </div>
                        <div class="col-md-4 text-end">

                            <a asp-area="Learner" asp-controller="Home" asp-action="Details"
                                asp-route-VideoCourseId="@courseStat.Course.Id"
                                class="btn btn-custom-outline">View</a>
                            <a asp-area="Instructor" asp-controller="Course" asp-action="UpsertVideo"
                                asp-route-id="@courseStat.Course.Id"
                                class="btn btn-custom">Edit</a>

                            @* <a class="btn btn-outline-dark">View</a> *@
                            @* <a class="btn btn-dark">Edit</a> *@
                        </div>
                    </div>
                </div>
            }

          
            <div class="d-flex justify-content-between align-items-center mb-3 pt-4">
                <h4 class="fw-semibold mb-0">Recent Enrollments</h4>
                <a asp-area="Admin" asp-controller="Enrollement" asp-action="index" class="btn btn-custom-outline"><i class="bi bi-eye"></i> View All</a>
            </div>
            

            <table id="tblenrollData1" class="table table-bordered table-striped display" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Course Name</th>
                        <th>Instructor Name</th>
                        <th>Total</th>
                    </tr>
                </thead>
              
            </table>
        </div>

        <div class="col-lg-4 p-4">
          
            <br /><br /><br />

            <div class="card mt-3 p-3 shadow-sm">
                <div class="d-flex align-items-center gap-3 mt-2">
                    <div>

                        <h6 class="mb-0 fw-bold">Quick Actions</h6>

                    </div>
                </div>

                <div class="mt-3">

                    <div class="p-2">
                        <a asp-area="Instructor" asp-controller="Course" asp-action="CourseType"
                           class="btn  btn-custom-outline p-2" style="width:100%"><i class="bi bi-plus" style="font-size:20px;"></i>  Create New Course</a>
                    </div>

                    <div class="p-2">
                        <a asp-area="Instructor" asp-controller="Course" asp-action="Index"
                           class="btn  btn-custom-outline  p-2" style="width:100%"><i class="bi bi-pencil-square" style="font-size:20px;"></i>  Edit Existing Course</a>
                    </div>

                    <div class="p-2">
                        <a asp-area="Admin" asp-controller="Enrollement" asp-action="Index"
                           class="btn  btn-custom-outline  p-2" style="width:100%"><i class="bi bi-people-fill" style="font-size:20px;"></i>  Enrolled Students</a>
                    </div>
                    <div class="p-2">
                        <a asp-area="Instructor" asp-controller="Course" asp-action="UpsertVideo"
                           class="btn  btn-custom-outline p-2" style="width:100%"><i class="bi bi-plus-circle" style="font-size:20px;"></i>  Create VideoCourse</a>
                    </div>

                </div>
            </div>
        </div>
    </div>

   

</div>

@section Scripts {
    <script src="~/js/enrollement.js"></script>
}

