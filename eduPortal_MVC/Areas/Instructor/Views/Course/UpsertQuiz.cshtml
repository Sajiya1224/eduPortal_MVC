@model QuizCourseVM



<!--Back to Create page link-->
<div class="col-ms-6 m-5 text-end">
	<a asp-controller="Course" asp-action="Create" class="btn cat-btn text-decoration-none">Back to Course Type</a>
</div>


<!--Basic Information Form-->

<div class="container col-12" >
	<h2 class="py-2">Create Quiz Course	</h2>
	<p class="text-muted"> Design an engaging quiz-based learning experience</p>
</div>

<div class="container card shadow-sm boreder-0 p-4 mb-4" style="border-radius: 14px;">
	<div class="col-12">
		<p class="p-2">Basic Information</p>	
	</div>
	<div class="row g-3">

	<div class="form-floating py-2 col-12">	
		<input asp-for="QuizCourse.Title" class="form-control border-0 shadow" />
			<label asp-for="QuizCourse.Title" class="ms-2"></label>
			<span asp-validation-for="QuizCourse.Title" class="text-danger"></span>
	</div>

	<div class="form-floating py-2 col-12">
			<input asp-for="QuizCourse.Description" class="form-control border-0 shadow" />
			<label asp-for="QuizCourse.Description" class="ms-2"></label>
			<span asp-validation-for="QuizCourse.Description" class="text-danger"></span>
	</div>

	<div class="form-floating py-2 col-6">
			<select asp-for="QuizCourse.CategoryId" asp-items="@Model.CategoryList"
				class="form-select border-0 shadow">
			<option disabled selected>Select category</option>
		</select>
			<label asp-for="QuizCourse.CategoryId"></label>
	</div>

		<div class="form-floating py-2 col-6">
			<select class="form-select border-0 shadow">
				<option disabled selected>Select difficulty</option>
				<option>Beginner</option> 
				<option>Intermediate</option> 
				<option>Advanced</option> 
		</select>
			<label asp-for="QuizCourse.Level" class="ms-2">Difficulty Level</label>
		</div>  
	<div class="form-floating py-2 col-12">

			<input asp-for="QuizCourse.Duration" class="form-control border-0 shadow" />
			<label asp-for="QuizCourse.Duration" class="ms-2"></label>
			<span asp-validation-for="QuizCourse.Duration" class="text-danger"></span>
	</div>

	</div>
</div>

<div class="container  col-12">
	<p style="font-size:30px">Quiz Question</p>
	<div class="col-ms-6 m-2 text-end">
		<button class="btn cat-btn text-decoration-none">Add Question</button>
	</div>
</div>


<div class="container card shadow-sm boreder-0 p-4 mb-4" style="border-radius: 14px;">
	<div class="col-12">
		<p class="p-2">Question 1</p>
	</div>
	<div class="row g-3">
             <div id="questions-container"> 

                         <!-- Question Text -->
				<div class="form-floating py-2 col-12">

					<input class="form-control border-0 shadow" placeholder="Enter your question..." />
					<label class="ms-2">Question Text</label>
					
				</div>


                         <!-- Answer Options -->

			 <div class="row g-3">

				<p class="col-12">Answer Option</p>
				<div class="form-floating col-12">
					<input class="form-control border-0 shadow" placeholder="your option" />
					<label class="ms-2">A.</label>
				</div>

				<div class="form-floating col-12">
					<input class="form-control border-0 shadow" placeholder="your option" />
					<label class="ms-2">B.</label>
				</div>

				<div class="form-floating col-12">
					<input class="form-control border-0 shadow" placeholder="your option" />
					<label class="ms-2">C.</label>
				</div>

				<div class="form-floating col-12">
					<input class="form-control border-0 shadow" placeholder="your option" />
					<label class="ms-2">D.</label>
				</div>
			 </div>
                         <!-- Correct Answer Dropdown -->

			 <div class="form-floating py-2 col-12">
				<select class="form-select border-0 shadow">
					<option disabled selected>Select difficulty</option>
					<option value="A">Option A</option>
					<option value="B">Option B</option>
					<option value="C">Option C</option>
					<option value="D">Option D</option>
				</select>
				<label class="ms-2">Correct Answer</label>
			 </div>

			 </div>
		
	</div>

	<div class="col-ms-12 m-2 text-end">
		<button class="btn btn-dark text-decoration-none">Create</button>
	</div>	
</div>







@section Scripts{
	@{
		<partial name="_ValidationScriptsPartial"/>
	}
}




































