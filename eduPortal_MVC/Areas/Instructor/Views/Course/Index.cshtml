
@{
    ViewData["Title"] = "Course List Page";
}


<div class="col-ms-6 m-5 text-end">
    <a asp-controller="Instructor" asp-action="Dashboard" class="btn cat-btn text-decoration-none">Back to Dashboard</a>
</div>

<div class="container">

    <div class=" m-lg-0 py-3 text-center">
        <h2 class="text-dark">Course List</h2>
    </div>

    <div class="col-12 p-2 text-end">
        <a class="btn btn-dark" asp-controller="Course" asp-action="CourseType"> <i class="bi bi-plus-circle"></i> Add Course</a>
    </div>


    <div class="card-body p-3">
        <table id="tblCourseData" class="table table-bordered table-striped display" style="width:100%">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Duration</th>
                    <th>Level</th>
                    <th>IsPublished</th>
                    <th>InstructorId</th>
                    <th></th>
                </tr>             
            </thead>

        </table>
    </div>
</div>


 @section Scripts {
     <script src="~/js/course.js"></script> 
 } 






