@model List<Course>
@{
    ViewData["Title"] = "Course List Page";
}


<div class="container">

    <div class=" m-lg-0 py-3 text-center">
        <h2 class="text-dark">Course List</h2>
    </div>

    <div class="col-12 p-2 text-end">
        <a class="btn btn-dark" asp-controller="" asp-action=""> <i class="bi bi-plus-circle"></i> Add Course</a>
    </div>


    <div class="card-body p-3">
        <table  class="table table-bordered table-striped display" style="width:100%">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Level</th>
                    <th>IsPublished</th>
                    <th></th>
                </tr>             
            </thead>
            <tbody>
                @foreach(var obj in Model)
                {
                    <tr>
                        <td>@obj.Title</td>
                        <td>@obj.Price</td>
                        <td>@obj.Duration</td>
                        <td>@obj.Level</td>
                        <td>@obj.IsPublished</td>
                        <td>
                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-secondary">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-controller="Category" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger">
                                <i class="bi bi-trash3-fill"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
                
            </tbody>
        </table>
    </div>
</div>


