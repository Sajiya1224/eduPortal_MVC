<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] LearnX</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eduPortal_MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel=" stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel=" stylesheet" href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="Learner" asp-controller="Home" asp-action="Index" style="font-size: 29px;"><i class="bi bi-journal-bookmark"></i> LearnX</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        @if(User.IsInRole(SD.Role_Instructor))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light btn btn-dark btn-lg px-4 py-2 shadow-sm" asp-area="Instructor" asp-controller="Course" asp-action="CourseType"><i class="bi bi-plus-circle"></i> Create Course</a>
                            </li>
                        }

                        @if (User.IsInRole(SD.Role_Admin))
                        {
                            <form class="d-flex mx-auto custom-search">
                                <input class="form-control rounded-pill search-input"
                                       type="search"
                                       placeholder="Search User and courses..."
                                       aria-label="Search">
                            </form> 
                            
                        }

                        @if(User.IsInRole(SD.Role_Learner))
                        {
                            <form class="d-flex mx-auto custom-search">
                                <input class="form-control rounded-pill search-input"
                                       type="search"
                                       placeholder="Search courses..."
                                       aria-label="Search">
                            </form>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Learner" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Learner" asp-controller="Home" asp-action="BrowseCourse">Courses</a>
                            </li>
                              <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Learner" asp-controller="" asp-action="">My Enrollement</a>  
                             </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity"  asp-page="/Account/Register" asp-route-role="Instructor">Become an Instructor</a>
                            </li>

                        } 
                          
                        @*  <li class="nav-item">  *@
                        @*      <a class="nav-link text-dark" asp-area="Admin" asp-controller="Category" asp-action="Index">Category</a>  *@
                        @*  </li>  *@
                        @*  <li class="nav-item">  *@
                        @*      <a class="nav-link text-dark" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>  *@
                        @*  </li> *@
                        @* <li class="nav-item"> *@
                        @*     <a class="nav-link text-dark" asp-area="Instructor" asp-controller="Instructor" asp-action="Index">Instructor Dashboard</a> *@
                        @* </li> *@
                    </ul>
                   
                    <partial name="_LoginPartial"/>
                </div>
            </div>
        </nav>
    </header>
    <div class="w-full m-0 p-0">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted"> *@
    @*     <div class="container"> *@
    @*         &copy; 2025 - eduPortal_MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
    @*     </div> *@
    @* </footer> *@


    <footer class="footer border-top py-4" style="background-color: #f8f9fc;">
        <div class="container">

            <div class="row">

                <!-- Logo + Description -->
                <div class="col-md-3 mb-4">
                    <h4 class="fw-bold mb-2">
                        <i class="bi bi-journal-bookmark"></i> LearnX
                    </h4>
                    <p class="text-muted">
                        Empowering learners worldwide with quality education.
                    </p>
                </div>

                <!-- Company Section -->
                <div class="col-md-3 mb-4">
                    <h5 class="fw-semibold mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a asp-area="Learner" asp-controller="Home" asp-action="BrowseCourse" class="text-muted text-decoration-none">Browse Course</a></li>
                        <li><a asp-area="Learner" asp-controller="" asp-action="" class="text-muted text-decoration-none">Student Dashboard</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register" asp-route-Role="Instructor" class="text-muted text-decoration-none">Become an Instructor</a></li>
                        
                    </ul>
                </div>

                <!-- Support Section -->
                <div class="col-md-3 mb-4">
                    <h5 class="fw-semibold mb-3">Account</h5>
                    <ul class="list-unstyled">
                        <li><a asp-area="Identity" asp-page="/Account/Login" class="text-muted text-decoration-none">Log in</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register" class="text-muted text-decoration-none">Sign Up</a></li>
                        <li><a asp-area="Learner" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a></li>
                       
                    </ul>
                </div>

                <!-- Teaching Section -->
                <div class="col-md-3 mb-4">
                    <h5 class="fw-semibold mb-3">Platform Stats</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted text-decoration-none">50,000+ Students</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">10,000+ Courses</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">5,000+ Instructor</a></li>
                    </ul>
                </div>

            </div>

            <hr />

            <div class="text-center text-muted">
                &copy; 2025 - LearnX -
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
            </div>

        </div>
    </footer>





    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tiny.cloud/1/a6771irdevyozaylz5a6whx1para7xyhf2bsr07yfv04ltmx/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdn.datatables.net/2.3.5/js/dataTables.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
